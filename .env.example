# Routee - Environment Variables
# Create a copy of this file named ".env" and fill in your keys.

# 1. SerpApi (For Google Flights Search)
# Get your free key here: https://serpapi.com/
EXPO_PUBLIC_SERPAPI_KEY=your_serpapi_key_here

# 2. Geoapify API (For Live Cities & Local Suggestions)
# Get a free key here: https://myprojects.geoapify.com/
EXPO_PUBLIC_GEOAPIFY_API_KEY=your_geoapify_api_key_here

# 3. AviationStack API (For Live Flight Status Notifications)
# Get a free key here: https://aviationstack.com/product
EXPO_PUBLIC_AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
